# Docker project name - CHANGE THIS for every new project. Use the same name as dockerLinux/.env
# so both folders share the database volume (<name>_db_data).
# Lowercase letters, digits and - only (it becomes the domain: <name>.localhost).
# Names the containers (<name>-web, <name>-pma, <name>-db) and the web image (<name>_web:local).
PROJECT_NAME=my-project
