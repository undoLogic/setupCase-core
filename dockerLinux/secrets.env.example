# Docker-only test secrets. Copy this file to secrets.env (gitignored) and fill it in.
# This repo is open source: never put keys in docker-compose.yml, .env or ini/php.ini.
# After editing secrets.env, run 1reStartDocker.sh so the container picks the values up.

# Files S3 Offload (docs/features/MVP-Files-S3-Offload.md)
# Use a test bucket and a key limited to that bucket only.
FILES_S3_KEY=
FILES_S3_SECRET=
FILES_S3_BUCKET=setupcase-test
# DigitalOcean Spaces: region e.g. tor1 and the endpoint below. AWS: your region, endpoint empty.
FILES_S3_REGION=tor1
FILES_S3_ENDPOINT=https://tor1.digitaloceanspaces.com
FILES_S3_PREFIX=files/
